d":"1-b8","name":"ライポア","heightMeters":1.79,"bats":"R","throws":"L","role":"SS","teamName":"TBD"},{"playerId":"1-p0","name":"ティカオ","heightMeters":1.84,"bats":"R","throws":"R","role":"P","teamName":"TBD"}],"fields":[{"path":"heightMeters","label":"身長","section":"common","unit":"m","type":"number","min":1.1,"max":2.5,"step":0.01,"entryPath":true},{"path":"reactionSeconds","label":"守備の初動遅延","section":"common","unit":"s","type":"number","min":0,"max":1,"step":0.01},{"path":"defensiveDecisionSeconds","label":"守備の判断遅延","section":"common","unit":"s","type":"number","min":0,"max":1,"step":0.01},{"path":"baserunningSafetyMarginSeconds","label":"走塁判断の安全余裕","section":"common","unit":"s","type":"number","min":0,"max":3,"step":0.05,"default":0.35,"note":"走塁の戦術的な判断傾向。大きいほど進塁に余裕を求めて慎重になります。走行速度・加速度は変わりません。未指定時は0.35秒。"},{"path":"fieldingPursuitCostWeight","label":"守備の追球コスト重み","section":"common","type":"number","min":0.25,"max":4,"step":0.05,"default":1,"note":"守備の戦術的な判断傾向。小さいほど移動コストを軽く見て積極的に追球します。身体能力や捕球能力は変わりません。未指定時は1。"},{"path":"topSpeedMps","label":"走行最高速度","section":"common","unit":"m/s","type":"number","min":0.1,"max":20,"step":0.1},{"path":"accelerationMps2","label":"走行加速度","section":"common","unit":"m/s²","type":"number","min":0.1,"max":20,"step":0.1},{"path":"baserunningTurnRadiusMeters","label":"走塁の回塁半径","section":"common","unit":"m","type":"number","min":0.5,"max":10,"step":0.1,"default":4.5,"note":"連続進塁で塁を回る経路の半径。未指定時は4.5m。旋回中の速度は横加速度の上限にも従います。"},{"path":"baserunningLateralAccelerationMps2","label":"走塁の横加速度上限","section":"common","unit":"m/s²","type":"number","min":0.5,"max":20,"step":0.1,"defaultFrom":"accelerationMps2","defaultScale":1.5,"note":"回塁中の方向転換に使う横加速度の上限。未指定時は選手の走行加速度の1.5倍。値を編集するまで個別設定として保存されません。"},{"path":"fieldJumpHeightMetersV115","label":"ジャンプの高さ","section":"common","unit":"m","type":"number","min":0,"max":1.5,"step":0.01,"defaultFromAthleticV115":"jumpHeightMeters","displayScale":0.01,"note":"未指定は身長の0.18倍です。高さは暫定調整値で、実際の到達は踏み切りと空中運動で決まります。 自動の初期値へ戻す操作で個別指定を解除できます。"},{"path":"fieldDivePushMpsV115","label":"飛び込みの踏み込み","section":"common","unit":"m/s","type":"number","min":0,"max":2,"step":0.01,"defaultFromAthleticV115":"divePushMps","note":"暫定調整値です。未指定は走行加速度から導出し、踏み込み速度に使います。 自動の初期値へ戻す操作で個別指定を解除できます。"},{"path":"fieldDiveRecoverySecondsV115","label":"飛び込み後の立ち上がり","section":"common","unit":"s","type":"number","min":0.1,"max":5,"step":0.01,"defaultFromAthleticV115":"diveRecoverySeconds","note":"暫定調整値です。未指定は反応時間とグラブ移動速度から導出します。 自動の初期値へ戻す操作で個別指定を解除できます。"},{"path":"fieldJumpRecoverySecondsV115","label":"ジャンプ後の立ち上がり","section":"common","unit":"s","type":"number","min":0.05,"max":3,"step":0.01,"defaultFromAthleticV115":"jumpRecoverySeconds","note":"暫定調整値です。未指定は反応時間から導出します。 自動の初期値へ戻す操作で個別指定を解除できます。"},{"path":"runSlideReachMetersV115","label":"滑り込みで伸ばす距離","section":"common","unit":"m","type":"number","min":0.2,"max":2,"step":0.01,"defaultFromAthleticV115":"slideReachMeters","displayScale":0.01,"note":"暫定調整値です。未指定は身長の0.48倍。実際の滑走は摩擦による減速に従い、塁への到達は保証されません。 自動の初期値へ戻す操作で個別指定を解除できます。"},{"path":"runHeadSlideExtraMetersV115","label":"ヘッドで伸ばす追加距離","section":"common","unit":"m","type":"number","min":0,"max":0.5,"step":0.01,"defaultFromAthleticV115":"headSlideExtraMeters","displayScale":0.01,"note":"暫定調整値です。未指定は5cm。実際の滑走は摩擦による減速に従います。 自動の初期値へ戻す操作で個別指定を解除できます。"},{"path":"runSlideRecoverySecondsV115","label":"滑り込み後の立ち上がり","section":"common","unit":"s","type":"number","min":0.1,"max":3,"step":0.01,"defaultFromAthleticV115":"slideRecoverySeconds","note":"暫定調整値です。未指定は反応時間から導出します。 自動の初期値へ戻す操作で個別指定を解除できます。"},{"path":"runHeadSlideRecoverySecondsV115","label":"ヘッド後の立ち上がり","section":"common","unit":"s","type":"number","min":0.1,"max":3,"step":0.01,"defaultFromAthleticV115":"headSlideRecoverySeconds","note":"暫定調整値です。未指定は反応時間から導出します。 自動の初期値へ戻す操作で個別指定を解除できます。"},{"path":"runHeadSlidePreferenceV115","label":"ヘッドを選ぶ傾向","section":"common","unit":"0〜1","type":"number","min":0,"max":1,"step":0.01,"defaultFromAthleticV115":"headSlidePreference","note":"暫定調整値です。未指定は0.2。選択の傾向であり、速度や到達判定は変えません。 自動の初期値へ戻す操作で個別指定を解除できます。"},{"path":"runSlideFrictionScaleV115","label":"地面の滑りにくさ（倍率）","section":"common","unit":"倍","type":"number","min":0.25,"max":3,"step":0.01,"defaultFromAthleticV115":"slideFrictionScale","note":"暫定調整値です。未指定は1倍。実際は球場の地面の摩擦による減速に掛ける倍率で、大きいほど減速します。 自動の初期値へ戻す操作で個別指定を解除できます。"},{"path":"gloveSpeedMps","label":"グラブ移動速度","section":"common","unit":"m/s","type":"number","min":0.1,"max":40,"step":0.1},{"path":"gloveReachMeters","label":"旧可動範囲（未設定の腕長に使う）","section":"common","unit":"m","type":"number","min":0.4,"max":3,"step":0.01,"note":"互換用の旧設定です。肩からグラブ中心までを未指定の時だけ、身長と合わせて腕長の初期値に使います。個別に腕長を指定した時は二重に適用しません。"},{"path":"fieldArmReachMetersV105","label":"肩からグラブ中心まで","section":"common","unit":"m","type":"number","min":0.2,"max":4,"step":0.01,"defaultFromBodyV105":"armReachMeters","bodyHeightRatioV105":false,"note":"肩から手を伸ばしたグラブ中心までの距離です。未指定は身長×0.491×（旧可動範囲÷1.35）の暫定値。旧可動範囲の値を腕長としてそのまま使いません。個別指定後は旧値を重ねて掛けません。 自動の初期値へ戻す操作で個別指定を解除できます。"},{"path":"fieldShoulderHeightRatioV105","label":"立ったときの肩の高さ","section":"common","unit":"身長の割合","type":"number","min":0.65,"max":0.88,"step":0.001,"defaultFromBodyV105":"shoulderHeightMeters","bodyHeightRatioV105":true,"note":"例：身長180cm、0.818なら肩の高さは約147cm。屈むと肩と目が一緒に下がります。未指定0.818は平均比例による暫定値です。 自動の初期値へ戻す操作で個別指定を解除できます。"},{"path":"fieldEyeHeightRatioV105","label":"立ったときの目の高さ","section":"common","unit":"身長の割合","type":"number","min":0.89,"max":0.99,"step":0.001,"defaultFromBodyV105":"eyeHeightMeters","bodyHeightRatioV105":true,"note":"例：身長180cm、0.92なら目の高さは約166cm。守備カメラもCoreのこの目の位置を使います。未指定は従来の0.92です。 自動の初期値へ戻す操作で個別指定を解除できます。"},{"path":"fieldCrouchFractionV105","label":"最大でどれだけ屈むか","section":"common","unit":"身長の割合","type":"number","min":0,"max":0.45,"step":0.01,"defaultFromBodyV105":"maximumCrouchMeters","bodyHeightRatioV105":true,"note":"例：身長180cm、0.36なら肩と目を最大約65cm下げられます。0は屈まない設定。低い球へ肩を近づける動作で、腕は伸びません。 自動の初期値へ戻す操作で個別指定を解除できます。"},{"path":"fieldPostureSpeedMpsV105","label":"屈む・立ち直る速さ","section":"common","unit":"m/s","type":"number","min":0.1,"max":8,"step":0.1,"defaultFromBodyV105":"postureSpeedMps","bodyHeightRatioV105":false,"note":"肩と目が上下する速さの上限です。例：0.5mを2.5m/sで動かすには最低0.2秒。捕球後の立ち直りは持ち替えと同時に進みます。未指定2.5。 自動の初期値へ戻す操作で個別指定を解除できます。"},{"path":"fieldTurnSpeedRadiansPerSecondV105","label":"身体の向き直りの速さ","section":"common","unit":"rad/s","type":"number","min":0.1,"max":12,"step":0.1,"defaultFromBodyV105":"turnSpeedRadiansPerSecond","bodyHeightRatioV105":false,"note":"身体を回す速さの上限です。4.5rad/sなら90度の向き直りに最低約0.35秒。目だけを回すカメラ設定とは別です。未指定4.5。 自動の初期値へ戻す操作で個別指定を解除できます。"},{"path":"fieldRearReachFractionV105","label":"肩より後ろへ届く割合","section":"common","unit":"腕の割合","type":"number","min":0,"max":0.5,"step":0.01,"defaultFromBodyV105":"rearReachFraction","bodyHeightRatioV105":false,"note":"例：腕の届く距離0.9m、0.12なら肩より後ろへ約11cmまで。後ろへ届かない球には身体の向きや位置を変えて近づきます。未指定0.12。 自動の初期値へ戻す操作で個別指定を解除できます。"},{"path":"gloveRadiusMeters","label":"グラブの接触半径","section":"common","unit":"m","type":"number","min":0.03,"max":0.3,"step":0.001},{"path":"retentionCapacityJ","label":"捕球の保持容量","section":"common","unit":"J","type":"number","min":1,"max":2000,"step":1},{"path":"captureDissipationPowerW","label":"捕球の吸収速度","section":"common","unit":"W","type":"number","min":10,"max":1000000,"step":100},{"path":"transferSeconds","label":"最短の持ち替え時間","section":"common","unit":"s","type":"number","min":0,"max":2,"step":0.01,"note":"捕球後の最短の持ち替えです。持ち替えの遅れ・手や姿勢の準備・力込めによって実際に投げるまでの総時間は延びます。肩力や送球精度とは独立しています。"},{"path":"transferDelayMaxSecondsV101","label":"持ち替えが遅れる幅","section":"common","unit":"s","type":"number","min":0,"max":2,"step":0.01,"default":0,"note":"基準0.30秒・遅れ幅0.15秒なら、持ち替えは0.30〜0.45秒。0はばらつきなし。同じ入力とseedでは同じ結果になります。手や姿勢の準備によって、捕球から実際に投げるまでの総時間はさらに延びます。"},{"path":"throwEffortBuildSecondsV103","label":"全力で投げるための準備（秒）","section":"common","unit":"s","type":"number","min":0,"max":5,"step":0.01,"default":0.6,"note":"全力まで力を込める追加準備の基準です。弱い出力ほど必要な時間は短くなり、手や姿勢の準備とは同時に進みます。0は追加の力込め時間なしで、出力の選択は続きます。未指定の旧JSONは共通の暫定値0.60秒で読み、元JSONは変更しません。"},{"path":"throwSpeedMps","label":"送球で出せる出力の基準","section":"common","unit":"m/s","type":"number","min":0.1,"max":80,"step":0.1,"note":"肩力に対応する潜在的な出力です。毎回この球速で投げる設定ではなく、距離・走者・受け手に応じて実際の送球出力と力込めを選びます。"},{"path":"throwDirectionStdRadians","label":"送球方向の誤差","section":"common","unit":"rad","type":"number","min":0,"max":0.12,"step":0.001},{"path":"batLengthM","label":"バット長","section":"batter","unit":"m","type":"number","min":0.2,"max":3,"step":0.01},{"path":"batMassKg","label":"バット質量","section":"batter","unit":"kg","type":"number","min":0.1,"max":5,"step":0.01},{"path":"swingRate","label":"参照軌道の時間倍率","section":"batter","unit":"倍","type":"number","min":0.3,"max":3,"step":0.01},{"path":"maximumSweetSpotSpeedMps","label":"芯の最大速度","section":"batter","unit":"m/s","type":"number","min":0.1,"max":90,"step":0.1},{"path":"targetSweetSpotSpeedMps","label":"狙う芯速度","section":"batter","unit":"m/s","type":"number","min":0.1,"max":90,"step":0.1},{"path":"timingStdSeconds","label":"打撃タイミング誤差","section":"batter","unit":"s","type":"number","min":0,"max":0.08,"step":0.001},{"path":"aimStdMeters","label":"打撃位置誤差","section":"batter","unit":"m","type":"number","min":0,"max":0.35,"step":0.001},{"path":"chaseMarginMeters","label":"打撃判断のゾーン外余裕","section":"batter","unit":"m","type":"number","min":0,"max":0.6,"step":0.01},{"path":"motorLatencySeconds","label":"判断後の運動開始遅延","section":"batter","unit":"s","type":"number","min":0,"max":2,"step":0.001},{"path":"technicalTimingOffsetSeconds","label":"技術による狙い時刻差","section":"batter","unit":"s","type":"number","min":-0.5,"max":0.5,"step":0.001},{"path":"sweetSpotT","label":"芯の位置（ノブ0・先端1）","section":"batter","unit":"比","type":"number","min":0.65,"max":0.9,"step":0.001},{"path":"attackAngleDegrees","label":"芯の上向き角","section":"batter","unit":"度","type":"number","min":-80,"max":80,"step":1},{"path":"pullAngleDegrees","label":"引張り方向の角","section":"batter","unit":"度","type":"number","min":-80,"max":80,"step":1},{"path":"badBallControl","label":"悪球打ちの内部技術","section":"batter","unit":"比","type":"number","min":0,"max":1,"step":0.01,"note":"悪球打ちの専用技術の強度です。独立方式では得能の設定だけを編集し、基礎能力・公開能力は変わりません。保有なしは実行値0です。"},{"path":"preContactSeconds","label":"接触前の軌道区間","section":"batter","unit":"s","type":"number","min":0.005,"max":2,"step":0.005},{"path":"followThroughSeconds","label":"接触後の軌道区間","section":"batter","unit":"s","type":"number","min":0.005,"max":2,"step":0.005},{"path":"contactDepthMeters","label":"狙う接触位置の奥行","section":"batter","unit":"m","type":"number","min":0.001,"max":2,"step":0.01},{"path":"swingDecision.threshold","label":"振る判断のしきい値","section":"batter","unit":"比","type":"number","min":0,"max":1,"step":0.01},{"path":"swingDecision.aggressionWeight","label":"積極性の重み","section":"batter","unit":"比","type":"number","min":0,"max":1,"step":0.01},{"path":"swingDecision.approach","label":"基本打撃方針","section":"batter","type":"select","options":[{"value":"AUTO","label":"自動判断"},{"value":"TAKE","label":"見送り"},{"value":"SWING","label":"振りにいく"}]},{"path":"pitchReleaseHeightMeters","label":"マウンド面からのリリース高","section":"pitcher","unit":"m","type":"number","min":0.2,"max":3.2,"step":0.001},{"path":"pitchReleaseSideMeters","label":"リリースの左右偏位量（利き手側）","section":"pitcher","unit":"m","type":"number","min":0,"max":1.5,"step":0.001},{"path":"pitchReleaseExtensionMeters","label":"リリースの前方への伸び（ラバーから）","section":"pitcher","unit":"m","type":"number","min":0,"max":3.5,"step":0.001},{"path":"releaseSpeedMps","label":"投球基準初速","section":"pitcher","unit":"m/s","type":"number","min":15,"max":85,"step":0.1},{"path":"maximumPitchSpeedMps","label":"投球最高初速","section":"pitcher","unit":"m/s","type":"number","min":15,"max":85,"step":0.1},{"path":"commandStdMeters","label":"投球の狙い位置誤差","section":"pitcher","unit":"m","type":"number","min":0,"max":0.6,"step":0.001},{"path":"spinRadPerSecond.x","label":"回転 X（世界座標）","section":"pitcher","unit":"rad/s","type":"number","min":-1200,"max":1200,"step":1},{"path":"spinRadPerSecond.y","label":"回転 Y（世界座標）","section":"pitcher","unit":"rad/s","type":"number","min":-1200,"max":1200,"step":1},{"path":"spinRadPerSecond.z","label":"回転 Z（世界座標）","section":"pitcher","unit":"rad/s","type":"number","min":-1200,"max":1200,"step":1},{"path":"zoneJudgmentStdMeters","label":"コース判断の位置誤差","section":"batter","unit":"m","type":"number","min":0,"max":0.6,"step":0.001}],"notes":["全20選手の数値は個別の暫定設定です。実在選手の実測値やリーグ相対能力を逆算した値ではありません。","ティカオの最高151km/hのみ既存のユーザー指定値です。その他の初期数値は編集できます。","成績の目標値や確率補正は設定していません。能力は判断・動作・ボール物理へ接続されます。","回転は世界座標の3成分です。回転率だけで球種や変化量は確定しません。","公開能力は個人SI基準を調整する作成用の暫定値です。公式リーグ評価の逆変換ではありません。","選球眼はコース判断の位置誤差へ作用します。積極性・悪球への技術・実際の投球位置は別です。","悪球打ちは得能欄で設定します。内部の窮屈な体勢での制御はその技術Sourceで、選球や悪球を振る積極性とは別です。未査定の旧JSONは数値だけで保有を決めません。","送球方向の誤差は基礎の精度です。送球Aなどの得能は独立した実行技術として保存し、基礎能力・公開能力を変更しません。","選球眼は1〜100の絶対能力。既存の個人公開値を初期値として引き継ぎ、リーグ比較では再計算しません。","リリース高・左右偏位・前方への伸びは全20選手で編集できます。初期値は身長×0.86m、身長×0.25m、1.54mというローカルな暫定設定で、個人の実測値ではありません。","リリース高はマウンド面からの高さです。通常試合のマウンド面はグラウンドから0.254m。左右偏位は正の距離で指定し、右投げ・左投げに従って世界座標の向きを変えます。","リリース位置は描画だけでなく実際の投球Source初期位置と狙いコースへの速度計算に反映します。選球眼・既存の公開能力・得能の初期値は引き継いでいます。","v103では肩力を出力能力、送球動作を最短の持ち替えとして扱います。全力で投げるための準備は暫定基準0.60秒。旧JSONの欠落値もこの共通基準を使い、欠落した持ち替えの遅れ幅は従来どおり0です。","V105：頭・肩・グラブ・屈みの身体寸法は暫定比例モデルです。詳細の個別指定と公開能力・得能は独立し、旧JSONは上書きしません。"]}
