+import { createRequire } from 'node:module';
+import type { DatabaseSync } from 'node:sqlite';
+
+/** Observe the real late writer reaching the sealed-owner census and rolling back.
+ * No result is substituted, and unrelated setup exceptions cannot satisfy this. */
+export const witnessActualFirstBasePositiveTailFence = (path: string, endSourceId: string) => {
+  const { DatabaseSync } = createRequire(import.meta.url)('node:sqlite') as typeof import('node:sqlite');
+  const prototype = DatabaseSync.prototype;
+  const prepareDescriptor = Object.getOwnPropertyDescriptor(prototype, 'prepare')!;
+  const execDescriptor = Object.getOwnPropertyDescriptor(prototype, 'exec')!;
+  const prepare = prepareDescriptor.value as DatabaseSync['prepare'];
+  const exec = execDescriptor.value as DatabaseSync['exec'];
+  const same = (a: PropertyDescriptor | undefined, b: PropertyDescriptor) => a !== undefined
+    && (['configurable', 'enumerable', 'value', 'writable', 'get', 'set'] as const).every(k => a[k] === b[k]);
+  let connection: DatabaseSync | null = null, begun = false, terminalClaimReached = false, rolledBack = false;
+  let changesBefore: number | bigint | null = null, changesAfter: number | bigint | null = null;
+  const restorers: (() => boolean)[] = [];
+  const databasePath = (db: DatabaseSync) => (Reflect.apply(prepare, db, ['PRAGMA database_list']) as ReturnType<DatabaseSync['prepare']>)
+    .all().find(row => row.name === 'main')?.file;
+  const changes = (db: DatabaseSync) => (Reflect.apply(prepare, db, ['SELECT total_changes() AS n']) as ReturnType<DatabaseSync['prepare']>).get()!.n;
+  const interceptExec = function(this: DatabaseSync, sql: string) {
+    const result = Reflect.apply(exec, this, [sql]);
+    if (sql === 'BEGIN IMMEDIATE' && databasePath(this) === path) {
+      if (connection !== null) throw new Error('late fence witness saw multiple writer transactions');
+      connection = this; begun = this.isTransaction; changesBefore = changes(this) as number | bigint;
+    }
+    if (this === connection && sql === 'ROLLBACK') {
+      rolledBack = !this.isTransaction; changesAfter = changes(this) as number | bigint;
+    }
+    return result;
+  };
+  const interceptPrepare = function(this: DatabaseSync, ...args: Parameters<DatabaseSync['prepare']>) {
+    const statement = Reflect.apply(prepare, this, args) as ReturnType<DatabaseSync['prepare']>;
+    if (this === connection && args[0].startsWith('SELECT source_id FROM actual_first_base_play_ends WHERE (game_id=$game AND play_id=$play)')) {
+      const db = this, original = Object.getOwnPropertyDescriptor(statement, 'all'), all = statement.all;
+      const wrapped = (...values: unknown[]) => {
+        const rows = Reflect.apply(all, statement, values) as Record<string, unknown>[];
+        terminalClaimReached = db.isTransaction && rows.length === 1 && rows[0].source_id === endSourceId;
+        return rows;
+      };
+      const installed = { configurable: true, enumerable: original?.enumerable ?? false, writable: true, value: wrapped };
+      Object.defineProperty(statement, 'all', installed);
+      restorers.push(() => {
+        if (!same(Object.getOwnPropertyDescriptor(statement, 'all'), installed)) return false;
+        if (original) Object.defineProperty(statement, 'all', original); else Reflect.deleteProperty(statement, 'all');
+        return true;
+      });
+    }
+    return statement;
+  };
+  const installedPrepare = { ...prepareDescriptor, value: interceptPrepare }, installedExec = { ...execDescriptor, value: interceptExec };
+  Object.defineProperty(prototype, 'prepare', installedPrepare); Object.defineProperty(prototype, 'exec', installedExec);
+  let closed = false;
+  return {
+    report: () => ({ begun, terminalClaimReached, rolledBack, changesBefore, changesAfter,
+      noTransaction: connection !== null && !connection.isTransaction }),
+    close() {
+      if (closed) return; closed = true;
+      let changed = false;
+      try {
+        for (const [name, installed, original] of [['prepare', installedPrepare, prepareDescriptor], ['exec', installedExec, execDescriptor]] as const) {
+          if (same(Object.getOwnPropertyDescriptor(prototype, name), installed)) Object.defineProperty(prototype, name, original);
+          else changed = true;
+        }
+        for (const restore of restorers) if (!restore()) changed = true;
+      } finally { restorers.length = 0; }
+      if (changed) throw new Error('late fence witness descriptor changed; later interceptor preserved');
+    },
+  };
+};
