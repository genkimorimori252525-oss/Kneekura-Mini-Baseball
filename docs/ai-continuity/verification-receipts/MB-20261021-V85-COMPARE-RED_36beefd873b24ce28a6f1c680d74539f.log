 function handle(id,action){$(id).addEventListener('change',()=>{try{assertReadyExcept([id]);action();pending.delete(id);$(id).setCustomValidity('');refresh();say('設定を共通の選手データへ反映しました。同じ番号で再試投できます。');}catch(e){markError(id,e);}});}
