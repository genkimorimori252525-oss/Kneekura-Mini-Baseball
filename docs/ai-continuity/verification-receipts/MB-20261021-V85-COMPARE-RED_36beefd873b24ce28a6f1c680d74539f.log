 const pitchInputIds=['pitcher-pitch-name','pitcher-pitch-speed','pitcher-pitch-rpm','pitcher-pitch-direction','pitcher-pitch-gyro','pitcher-seam-enabled','pitcher-seam-scale','pitcher-seam-yaw','pitcher-seam-pitch','pitcher-seam-roll'];
 // These conversions only edit the initial ball orientation. Flight remains Core-owned.
 function orientationFromAngles(prefix){const yaw=number(prefix+'-yaw')*Math.PI/360,pitch=number(prefix+'-pitch')*Math.PI/360,roll=number(prefix+'-roll')*Math.PI/360,cy=Math.cos(yaw),sy=Math.sin(yaw),cp=Math.cos(pitch),sp=Math.sin(pitch),cr=Math.cos(roll),sr=Math.sin(roll);
