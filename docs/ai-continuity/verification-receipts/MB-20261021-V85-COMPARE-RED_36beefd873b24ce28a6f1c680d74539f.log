  const before=snapshot(),previousSelection=selectedPitch,next=clone(before),repertoire=ensureRepertoire(entry(next).physical);repertoire.pitches=repertoire.pitches.filter(p=>p.pitchId!==pitchId);commit(next);removedPitch={pitcherId,selectedPitch:previousSelection,before,after:snapshot()};removalUndoReason='';refresh();say(row.name+'を所持球から削除しました。「削除を取り消す」で直前の状態に戻せます。');return snapshot();}
