  return {w:cy*cp*cr+sy*sp*sr,x:cy*sp*cr+sy*cp*sr,y:sy*cp*cr-cy*sp*sr,z:cy*cp*sr-sy*sp*cr};}
 function anglesFromOrientation(q={w:1,x:0,y:0,z:0}){const {w,x,y,z}=q,sine=Math.max(-1,Math.min(1,2*(w*x-y*z))),gimbal=Math.abs(sine)>=.9999999;return {yaw:(gimbal?Math.atan2(2*(w*y-x*z),1-2*(y*y+z*z)):Math.atan2(2*(x*z+w*y),1-2*(x*x+y*y)))*180/Math.PI,pitch:Math.asin(sine)*180/Math.PI,roll:(gimbal?0:Math.atan2(2*(x*y+w*z),1-2*(x*x+z*z)))*180/Math.PI};}
 function seamFields(prefix,row){$(prefix+'-enabled').checked=!!row.seamForce;const a=anglesFromOrientation(row.releaseOrientation);for(const key of ['yaw','pitch','roll'])put(prefix+'-'+key,Number(a[key].toPrecision(12)));put(prefix+'-scale',row.seamForce?.coefficientScale??1);}
 function readSeam(prefix,preserveOrientation=false){if(!$(prefix+'-enabled').checked)return preserveOrientation?{releaseOrientation:orientationFromAngles(prefix)}:{};return {releaseOrientation:orientationFromAngles(prefix),seamForce:{version:'baseball_seam_force_v1',coefficientScale:number(prefix+'-scale')}};}
 function arrow(spin){const c=core.pitchSpinToControlsV77(spin),r=c.breakDirectionDegrees*Math.PI/180,length=12*Math.sqrt(Math.max(0,1-c.gyroFraction*c.gyroFraction)),x=19+Math.sin(r)*length,y=19-Math.cos(r)*length;
  return `<svg viewBox=\"0 0 38 38\" aria-hidden=\"true\"><circle cx=\"19\" cy=\"19\" r=\"17\"></circle><line x1=\"19\" y1=\"19\" x2=\"${x}\" y2=\"${y}\"></line><circle cx=\"${x}\" cy=\"${y}\" r=\"2.3\" style=\"fill:#286644\"></circle></svg>`;}
 function put(id,value){if(!pending.has(id))$(id).value=value;}
 function refresh(){
  const p=currentPlayer(),e=entry(),physical=p.physical,abilities=projection().abilities;
  $('pitcher-player').value=pitcherId;put('pitcher-hand',p.throws??'R');
  for(const [id,ability]of [['pitcher-public-speed','maxSpeedKmh'],['pitcher-public-control','control']])put(id,Number(abilities.find(a=>a.id===ability)?.value?.toPrecision(12)));
  $('pitcher-public-grade').textContent=maker.publicRank(abilities.find(a=>a.id==='control')?.value);
  put('pitcher-release-height',physical.pitchReleaseHeightMeters??p.heightMeters*.86);put('pitcher-release-side',physical.pitchReleaseSideMeters??p.heightMeters*.25);put('pitcher-release-extension',physical.pitchReleaseExtensionMeters??1.54);
  put('pitcher-motion-duration',physical.pitchingMotion?.preparationMs??1540);put('pitcher-motion-head',physical.pitchingMotion?.headMotionScale??1);
  put('pitcher-spin-minimum',(physical.minimumSpinRatio??1)*100);selectedPitch=currentRow().pitchId;
  const cards=$('pitcher-cards');cards.replaceChildren();for(const row of rows()){
   const b=document.createElement('button');b.type='button';b.className='pitcher-card';b.dataset.pitchType=row.pitchType;b.dataset.pitchId=row.pitchId;b.setAttribute('aria-pressed',String(row.pitchId===selectedPitch));
   b.innerHTML=arrow(row.spinRadPerSecond);const text=document.createElement('span'),strong=document.createElement('strong'),small=document.createElement('small');strong.textContent=row.name;small.textContent=names[row.pitchType]+' · '+(row.releaseSpeedMps*3.6).toFixed(1)+' km/h';text.append(strong,small);b.append(text);
   b.onclick=()=>{try{selectPitch(row.pitchId);}catch(e){say(e,true);}};cards.append(b);
  }
  const row=currentRow(),spin=core.pitchSpinToControlsV77(row.spinRadPerSecond);
  put('pitcher-pitch-name',row.name);seamFields('pitcher-seam',row);
  put('pitcher-pitch-speed',Number((row.releaseSpeedMps*3.6).toPrecision(12)));put('pitcher-pitch-rpm',Number(spin.spinRpm.toPrecision(12)));put('pitcher-pitch-direction',Number(spin.breakDirectionDegrees.toPrecision(12)));put('pitcher-pitch-gyro',Number(spin.gyroFraction.toPrecision(12)));
  $('pitcher-pitch-note').textContent=names[row.pitchType]+'。'+(physical.pitchRepertoireV78?'この選手が持つ球の数値を表示しています。作成元を後で編集しても自動更新しません。':'従来の7球を参考表示しています。球を保存・追加した時にだけ、現在の7球を新版へコピーします。');
  $('pitcher-pitch-reset').disabled=cards.children.length<=1;$('pitcher-pitch-reset').title=cards.children.length<=1?'所持球は最低1球必要です。':'';
  root.KneekuraMakerHelp?.decorate(panel);
