  const next=snapshot(),e=entry(next),repertoire=ensureRepertoire(e.physical);repertoire.pitches=repertoire.pitches.map(p=>p.pitchId===selectedPitch?row:p);commit(next);clearPitchPending();refresh();say(row.name+'の設定を保存しました。');}
